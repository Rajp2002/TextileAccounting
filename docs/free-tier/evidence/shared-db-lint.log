{"results":[{"function":"public.settle_worker_payroll","issues":[{"level":"error","message":"constraint \"payroll_unique_meter_worker_month\" for table \"payroll_payments\" does not exist","statement":{"lineNumber":"13","text":"SQL statement"},"context":"SQL statement \"INSERT INTO payroll_payments (org_id, worker_type, meter_worker_id, fixed_worker_id, month, amount, paid, paid_at)\n        VALUES (p_org_id, p_worker_type, p_worker_id, NULL, p_month, p_gross_amount, true, now())\n        ON CONFLICT ON CONSTRAINT payroll_unique_meter_worker_month\n        DO UPDATE SET amount = EXCLUDED.amount, paid = true, paid_at = now()\n        RETURNING id\"","sqlState":"42704"}]},{"function":"public.get_daily_brief_stats","issues":[{"level":"error","message":"column w.rate_per_meter does not exist","statement":{"lineNumber":"13","text":"SQL statement"},"query":{"position":"87","text":"SELECT\n        COALESCE(SUM(pl.meters), 0),\n        COALESCE(SUM(pl.meters * COALESCE(w.rate_per_meter, 0)), 0)\n                                                FROM production_logs pl\n    LEFT JOIN workers w ON w.id = pl.worker_id\n    WHERE pl.org_id = p_org_id\n      AND pl.date = p_date"},"sqlState":"42703"}]},{"function":"public.get_yield_alert","issues":[{"level":"error","message":"column yb.weight_kg does not exist","statement":{"lineNumber":"12","text":"SQL statement"},"query":{"position":"39","text":"select\n    count(*),\n    coalesce(sum(yb.weight_kg * q.target_yield_per_kg), 0),\n    coalesce(sum(batch_actual.actual_meters), 0),\n    coalesce(avg(q.sale_price_per_m), 0)\n                                                                             from yarn_batches yb\n  join qualities q on q.id = yb.quality_id\n  left join lateral (\n    select coalesce(sum(pl.meters), 0) as actual_meters\n    from production_logs pl\n    where pl.yarn_batch_id = yb.id\n  ) batch_actual on true\n  where yb.org_id = p_org_id\n    and yb.status = 'consumed'"},"sqlState":"42703"}]},{"function":"public.replace_shift_production_logs","issues":[{"level":"error","message":"relation \"weavly_shift_logs\" does not exist","statement":{"lineNumber":"71","text":"SQL statement"},"query":{"position":"8","text":"UPDATE weavly_shift_logs\n  SET\n    meter_worker_id = COALESCE(meter_worker_id, worker_id),\n    operator_worker_type = CASE\n      WHEN operator_worker_type IS NOT NULL THEN operator_worker_type\n      WHEN COALESCE(worker_id, meter_worker_id) IS NOT NULL THEN 'meter_worker'\n      WHEN fixed_worker_id IS NOT NULL THEN 'fixed_worker'\n      ELSE NULL\n    END,\n    operator_pay_mode_snapshot = COALESCE(operator_pay_mode_snapshot, CASE WHEN COALESCE(worker_id, meter_worker_id) IS NOT NULL THEN 'per_meter' END),\n    operator_rate_snapshot = COALESCE(operator_rate_snapshot, worker_rate_snapshot),\n    machine_type_snapshot = COALESCE(machine_type_snapshot, 'other')\n  WHERE TRUE"},"sqlState":"42P01"}]}],"message":"db lint"}
