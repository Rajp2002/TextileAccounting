### Ran Playwright code
```js
await (async (page) => {
const cases = [["quotes", "lite", 320, 568], ["quotes", "lite", 430, 932], ["quotes", "lite", 1440, 900], ["quotes", "base", 320, 568]]; const results = [];
for (const [view,tier,width,height] of cases) {
  const context=await page.context().browser().newContext({viewport:{width,height},hasTouch:width<768,isMobile:width<768});
  try {
    const p=await context.newPage();
    await p.goto(`http://127.0.0.1:4195/owner/${view}?tier=${tier}&prior=1`);
    await p.locator('h1').waitFor(); await p.waitForTimeout(650);
    const file=`/Users/rajpatel/Projects/textile Saas/output/playwright/lite-mobile-records/before-prior/${view}-${tier}-${width}.png`;
    await p.screenshot({path:file,fullPage:true});
    results.push({view,tier,width,height,file,heading:await p.locator('h1').innerText(),scrollWidth:await p.evaluate(()=>document.documentElement.scrollWidth)});
  } finally { await context.close(); }
}
return results;
})(page);
```
