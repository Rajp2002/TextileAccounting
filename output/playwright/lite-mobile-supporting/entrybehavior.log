ral Code (Optional)',{exact:true}).inputValue()==='WEAVLY-TEST','Lite referral closes/reopens without losing input');await page.locator('#factoryName').fill('Synthetic Factory');await page.locator('#ownerName').fill('Synthetic Owner');await page.locator('#email').fill('invalid');await page.locator('#phone').fill('9876543210');await page.locator('#password').fill('Synthetic!2Pass');await page.locator('#confirmPassword').fill('Synthetic!2Pass');await page.locator('#email').focus();await page.locator('#phone').focus();assert(await page.locator('#email').getAttribute('aria-invalid')==='true','Lite invalid email feedback remains visible');await page.locator('#email').fill('synthetic@example.test');await page.getByRole('checkbox').check();await page.getByRole('button',{name:'Create factory',exact:true}).click();await page.getByText('We could not confirm your signup. Your account may already exist: try to log in, or reset your password, before signing up again.',{exact:true}).waitFor();assert(await page.locator('#factoryName').inputValue()==='Synthetic Factory','uncertain Lite signup retains factory identity');assert(await page.locator('#email').inputValue()==='synthetic@example.test','uncertain Lite signup retains email input');return results}
