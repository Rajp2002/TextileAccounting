  require(await page.getByRole('button', { name: 'Watch demo', exact: true }).count() === 3, 'Paid-origin preview still present')
  report.push({ check: 'Paid-origin plans preserve preview composition', result: 'passed' })
  await page.goto(base + 'fixture?kind=signup&ref=WEAVLY-TEST')
  await ready()
  require(await page.getByLabel('Referral Code (Optional)', { exact: true }).inputValue() === 'WEAVLY-TEST', 'Query referral retained')
  await page.getByRole('button', { name: 'Referral Code (Optional)', exact: true }).click()
  require(await page.getByLabel('Referral Code (Optional)', { exact: true }).isHidden(), 'Referral can be collapsed')
  await page.getByRole('button', { name: 'Referral Code (Optional)', exact: true }).click()
  require(await page.getByLabel('Referral Code (Optional)', { exact: true }).inputValue() === 'WEAVLY-TEST', 'Referral retained after dismissal')
  await page.getByLabel('Your name', { exact: true }).fill('R')
  await page.getByLabel('Email', { exact: true }).focus()
  require(await page.getByLabel('Your name', { exact: true }).getAttribute('aria-invalid') === 'true', 'Name validation wired')
  require(await page.getByLabel('Your name', { exact: true }).getAttribute('aria-describedby') === 'ownerName-error', 'Name error described')
  await page.getByLabel('Your name', { exact: true }).fill('Synthetic Owner')
  await page.getByLabel('Email', { exact: true }).fill('owner@example.test')
  await page.getByLabel('Phone Number', { exact: true }).fill('9876543210')
  await page.getByLabel('Password', { exact: true }).fill('Synthetic!2Pass')
  await page.getByLabel('Confirm password', { exact: true }).fill('Synthetic!2Pass')
  for (const label of ['Your name', 'Email', 'Phone Number', 'Password', 'Confirm password']) {
    require((await page.getByLabel(label, { exact: true }).boundingBox()).height >= 44, `${label} mobile input target`)
  }
  const passwordToggle = await page.getByRole('button', { name: 'Show password', exact: true }).boundingBox()
  require(passwordToggle.height >= 44 && passwordToggle.width >= 44, 'Password visibility target 44 px')
