  await page.goto(base + 'fixture?kind=verify&email=owner@example.test&rate-limit=1')
  await ready()
  await page.getByRole('button', { name: 'Resend verification email', exact: true }).click()
  await page.getByRole('alert').filter({ hasText: 'Too many requests. Please wait a minute before trying again.' }).waitFor()
  await page.goto(base + 'fixture?kind=verify')
  await ready()
  require(await page.getByRole('button', { name: 'Resend verification email', exact: true }).isDisabled(), 'Missing email has actionable recovery, no empty resend')
  await reflow('Verification recovery 320')
  await page.goto(base + 'fixture?kind=forgot')
  await ready()
  await page.getByLabel('Email', { exact: true }).fill('invalid')
  await page.getByRole('button', { name: 'Send instructions', exact: true }).click()
  require(await page.getByLabel('Email', { exact: true }).getAttribute('aria-invalid') === 'true', 'Reset email invalid state preserved')
  await page.getByLabel('Email', { exact: true }).fill('owner@example.test')
  await page.getByRole('button', { name: 'Send instructions', exact: true }).click()
  await page.getByText('If an account exists for that email, we’ve sent password reset instructions.', { exact: true }).first().waitFor()
  await reflow('Neutral reset confirmation 320')
  for (const language of ['en', 'hi', 'gu']) {
    await page.evaluate(language => localStorage.setItem('weavly_language', language), language)
    for (const kind of ['plans', 'signup', 'login', 'verify']) {
      await page.goto(base + `fixture?kind=${kind}&from=estimator`)
      await ready()
      await page.waitForFunction(language => document.documentElement.lang === language, language)
      await reflow(`${kind} ${language} 320`)
      await page.screenshot({ path: `output/playwright/free-mobile-redesign/entry/${kind}-after-320-${language}.png`, fullPage: true })
      await page.evaluate(() => document.documentElement.style.fontSize = '200%')
      await reflow(`${kind} ${language} 320 enlarged text`)
      await page.screenshot({ path: `output/playwright/free-mobile-redesign/entry/${kind}-after-320-${language}-text200.png`, fullPage: true })
    }
  }
  await page.evaluate(() => localStorage.setItem('weavly_language', 'en'))
  return report
}
)(page);
