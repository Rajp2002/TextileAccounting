await (async page => {
  const report = []
  const base = 'http://127.0.0.1:4188/'
  await page.evaluate(() => localStorage.setItem('weavly_language', 'en'))
  const require = (condition, message) => { if (!condition) throw new Error(message) }
  const ready = async () => { await page.getByRole('heading', { level: 1 }).waitFor() }
  const reflow = async label => {
    const geometry = await page.evaluate(() => ({ width: innerWidth, scrollWidth: document.documentElement.scrollWidth }))
    require(geometry.scrollWidth <= geometry.width, `${label}: horizontal overflow ${JSON.stringify(geometry)}`)
    report.push({ check: label, result: 'passed', ...geometry })
  }
  await page.setViewportSize({ width: 320, height: 740 })
  await page.goto(base + 'fixture?kind=plans&from=estimator', {waitUntil: 'domcontentloaded'})
  await ready()
  await page.waitForFunction(() => document.documentElement.lang === 'en')
  require(await page.getByRole('link', { name: 'Back to Estimator' }).getAttribute('href') === '/free', 'Free estimator Back destination')
  require(await page.getByRole('heading', { name: 'Weavly Base', exact: true }).count() === 1, 'All three plan options present')
  await page.getByRole('button', { name: 'Switch language', exact: true }).click()
  const languageOptions = await page.locator('button[aria-current]').locator('..').locator('button').evaluateAll(nodes => nodes.map(node => {
    const rect = node.getBoundingClientRect()
    return { height: rect.height, left: rect.left, right: rect.right }
  }))
  require(languageOptions.every(rect => rect.height >= 44 && rect.left >= 0 && rect.right <= 320), 'Language options have 44 px targets and fit viewport')
  await page.locator('button[aria-current="true"]').click()
  report.push({ check: 'Free language dropdown targets and bounds 320', result: 'passed' })
  require(await page.getByRole('button', { name: 'Watch demo', exact: true }).count() === 0, 'Mobile demos optional by default')
  const detail = page.getByRole('button', { name: 'Features and demo', exact: true }).first()
  await detail.click()
  require(await page.getByRole('button', { name: 'Hide details', exact: true }).getAttribute('aria-expanded') === 'true', 'Disclosure expansion')
  await page.getByRole('button', { name: 'Watch demo', exact: true }).click()
  await page.getByRole('dialog').waitFor()
  await page.keyboard.press('Escape')
  await page.getByRole('dialog').waitFor({ state: 'hidden' })
  require(await page.getByRole('button', { name: 'Watch demo', exact: true }).evaluate(el => el === document.activeElement), 'Demo focus returns after dismissal')
  await page.getByRole('button', { name: 'Hide details', exact: true }).click()
  await reflow('Free plans 320 disclosure open/close')
  await page.goto(base + 'fixture?kind=plans&current=lite')
