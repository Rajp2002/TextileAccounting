await (async page => {
  const reports = []
  const method = 'At320x740, keep html root font/viewport/layout dimensions unchanged; freeze every body HTMLElement original computed font-size and line-height, then set its font-size and numeric line-height to200% as absolute px. Keep normal line-height normal, so its font metrics scale. SVG icon sizes, rem spacing and transform/zoom are unchanged.'
  await page.setViewportSize({ width: 320, height: 740 })
  for (const language of ['en', 'hi', 'gu']) {
    await page.evaluate(language => localStorage.setItem('weavly_language', language), language)
    for (const kind of ['plans', 'signup', 'login', 'verify']) {
      await page.goto(`http://127.0.0.1:4188/fixture?kind=${kind}&from=estimator${kind==='verify'?'&email=owner@example.test':''}`, { waitUntil: 'domcontentloaded' })
      await page.getByRole('heading', { level: 1 }).waitFor()
      await page.waitForFunction(language => document.documentElement.lang === language, language)
      const sizing = await page.evaluate(() => {
        const rootFontBefore=getComputedStyle(document.documentElement).fontSize
        const viewportBefore={ width:innerWidth,height:innerHeight,scale:visualViewport?.scale }
        const elements=[document.body,...document.body.querySelectorAll('*')].filter(node=>node instanceof HTMLElement)
        const originals=elements.map(node=>({node,fontSize:parseFloat(getComputedStyle(node).fontSize),lineHeight:getComputedStyle(node).lineHeight}))
        for(const original of originals){original.node.style.setProperty('font-size', `${original.fontSize*2}px`, 'important');if(original.lineHeight!=='normal')original.node.style.setProperty('line-height',`${parseFloat(original.lineHeight)*2}px`,'important')}
        const numeric=originals.filter(original=>original.lineHeight!=='normal')
        return {rootFontBefore,rootFontAfter:getComputedStyle(document.documentElement).fontSize,viewportBefore,viewportAfter:{width:innerWidth,height:innerHeight,scale:visualViewport?.scale},elementsResized:originals.length,numericLineHeightsResized:numeric.length,normalLineHeights:originals.length-numeric.length,invalidFontRatios:originals.filter(original=>Math.abs(parseFloat(getComputedStyle(original.node).fontSize)-original.fontSize*2)>.1).length,invalidLineRatios:numeric.filter(original=>Math.abs(parseFloat(getComputedStyle(original.node).lineHeight)-parseFloat(original.lineHeight)*2)>.1).length}
      })
      await page.evaluate(()=>new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve))))
      const geometry = await page.evaluate(() => {
        const issues=[],round=value=>Math.round(value*100)/100
        const visible=node=>{const r=node.getBoundingClientRect(),style=getComputedStyle(node);return r.width>0&&r.height>0&&style.visibility!=='hidden'&&style.display!=='none'&&!node.closest('[aria-hidden="true"]')&&!node.closest('.sr-only')}
        const label=node=>(node.getAttribute('aria-label')||node.innerText||node.textContent||node.id||node.tagName).trim().replace(/\s+/g,' ').slice(0,150)
        const box=rect=>({left:round(rect.left),right:round(rect.right),top:round(rect.top),bottom:round(rect.bottom),width:round(rect.width),height:round(rect.height)})
        for(const node of document.body.querySelectorAll('*')){
          if(!(node instanceof HTMLElement)||!visible(node))continue
          for(const text of node.childNodes){
            if(text.nodeType!==Node.TEXT_NODE||!text.textContent.trim())continue
            const range=document.createRange();range.selectNodeContents(text)
            for(const rect of range.getClientRects()){
              if(rect.width<1||rect.height<1)continue
              if(rect.left<-.5||rect.right>innerWidth+.5)issues.push({type:'text-outside-viewport',tag:node.tagName,text:text.textContent.trim().replace(/\s+/g,' ').slice(0,150),textBox:box(rect)})
              for(let ancestor=node;ancestor&&ancestor!==document.documentElement;ancestor=ancestor.parentElement){
                const style=getComputedStyle(ancestor),clip=ancestor.getBoundingClientRect()
                if(['hidden','clip'].includes(style.overflowX)&&(rect.left<clip.left-.5||rect.right>clip.right+.5))issues.push({type:'text-clipped-x',tag:node.tagName,text:text.textContent.trim().slice(0,150),clipTag:ancestor.tagName,textBox:box(rect),clipBox:box(clip)})
                if(['hidden','clip'].includes(style.overflowY)&&(rect.top<clip.top-.5||rect.bottom>clip.bottom+.5))issues.push({type:'text-clipped-y',tag:node.tagName,text:text.textContent.trim().slice(0,150),clipTag:ancestor.tagName,textBox:box(rect),clipBox:box(clip)})
              }
            }
          }
        }
        const controls=[...document.querySelectorAll('input:not([type=checkbox]),button,a')].filter(visible).map(node=>{const style=getComputedStyle(node),rect=node.getBoundingClientRect();return {tag:node.tagName,label:label(node),box:box(rect),fontSize:style.fontSize,lineHeight:style.lineHeight,whiteSpace:style.whiteSpace,scrollWidth:node.scrollWidth,clientWidth:node.clientWidth,scrollHeight:node.scrollHeight,clientHeight:node.clientHeight,paddingY:round(parseFloat(style.paddingTop)+parseFloat(style.paddingBottom))}})
        for(const control of controls){if(control.tag==='INPUT'&&parseFloat(control.lineHeight)>control.clientHeight-control.paddingY+1)issues.push({type:'input-linebox-exceeds-content-height',label:control.label,lineHeight:control.lineHeight,contentHeight:round(control.clientHeight-control.paddingY),box:control.box});if(control.tag==='BUTTON'&&control.scrollHeight>control.clientHeight+1)issues.push({type:'button-content-overflow-height',label:control.label,scrollHeight:control.scrollHeight,clientHeight:control.clientHeight,box:control.box})}
        const deduplicated=[...new Map(issues.map(issue=>[JSON.stringify(issue),issue])).values()]
        return {viewportWidth:innerWidth,documentScrollWidth:document.documentElement.scrollWidth,bodyScrollWidth:document.body.scrollWidth,issues:deduplicated,controls}
      })
      const screenshot=`output/playwright/free-mobile-redesign/entry/${kind}-text-only200-320-${language}.png`
      await page.screenshot({ path:screenshot,fullPage:true })
      reports.push({kind,language,method,sizing,geometry,screenshot,result:geometry.documentScrollWidth<=320&&geometry.issues.length===0?'passed':'issues-found'})
    }
  }
  return reports
}
)(page);
